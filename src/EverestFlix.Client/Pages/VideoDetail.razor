@page "/video/{Id:int}"
@inject EverestFlixApiClient Api
@inject IConfiguration       Config

<PageTitle>@(_video?.Title ?? "Video") · EverestFlix</PageTitle>

@if (_loading)
{
    <div class="ef-empty"><p>Loading…</p></div>
}
else if (_video is null)
{
    <div class="ef-empty">
        <h2>Video not found</h2>
        <p>The video you're looking for doesn't exist or has been removed.</p>
    </div>
}
else
{
    <div class="detail-page">
        <div class="detail-grid">
            <div class="player-column">
                <div class="phone-frame">
                    <video controls autoplay muted playsinline preload="metadata">
                        <source src="@Absolute(_video.VideoUrl)" type="video/mp4" />
                    </video>
                </div>
            </div>

            <div class="meta-column">
                <h1>@_video.Title</h1>
                <p class="creator">by @_video.CreatorName</p>
                <div class="chips">
                    <span class="chip">#@_video.Genre</span>
                    <span class="chip">@_video.AgeRating</span>
                    <span class="chip">@_video.ViewCount views</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_video.Description))
                {
                    <p class="description">@_video.Description</p>
                }
                <dl class="specs">
                    <dt>Publisher</dt> <dd>@_video.Publisher</dd>
                    <dt>Producer</dt>  <dd>@_video.Producer</dd>
                    <dt>Uploaded</dt>  <dd>@_video.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
}

<style>
    .detail-page {
        padding: 2rem;
        height: 100%;
        overflow-y: auto;
        background: var(--ef-bg);
    }
    .detail-grid {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 2.5rem;
        max-width: 1000px;
        margin: 0 auto;
        align-items: start;
    }
    .player-column { display: flex; justify-content: center; }
    .phone-frame {
        position: relative;
        width: 360px;
        aspect-ratio: 9 / 16;
        background: #000;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.15);
        border: 1px solid var(--ef-border);
    }
    .phone-frame video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .meta-column h1 { margin-bottom: 0.25rem; }
    .meta-column .creator { color: var(--ef-brown); margin: 0 0 1rem; }
    .chips { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .chip {
        background: var(--ef-surface);
        border: 1px solid var(--ef-border);
        padding: 0.25rem 0.7rem;
        border-radius: 999px;
        font-size: 0.8rem;
        color: var(--ef-brown);
    }
    .description {
        line-height: 1.6;
        margin: 1rem 0;
        padding: 1rem;
        background: var(--ef-surface);
        border-radius: var(--ef-radius);
        border: 1px solid var(--ef-border);
    }
    .specs {
        display: grid;
        grid-template-columns: max-content 1fr;
        column-gap: 1.5rem;
        row-gap: 0.35rem;
        margin-top: 1.5rem;
    }
    .specs dt { color: var(--ef-brown); font-weight: 600; }
    .specs dd { margin: 0; }

    @@media (max-width: 768px) {
        .detail-page { padding: 1rem; }
        .detail-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
        .phone-frame { width: 100%; max-width: 360px; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private EverestFlix.Client.Models.VideoDetail? _video;
    private bool   _loading = true;
    private string _apiBase = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _apiBase = Config["ApiBaseUrl"] ?? string.Empty;
        _loading = true;
        _video   = await Api.GetVideoAsync(Id);
        _loading = false;
    }

    private string Absolute(string url) =>
        url.StartsWith("http") ? url : $"{_apiBase.TrimEnd('/')}{url}";
}