@page "/creator/dashboard"

@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Creator")]

@inject EverestFlixApiClient Api
@inject IConfiguration Config
@inject NavigationManager Nav


<PageTitle>Creator Dashboard · EverestFlix</PageTitle>


<div class="dashboard">

    <div class="header">

        <h1>
            Creator Dashboard
        </h1>

        <a href="/creator/upload"
           class="upload-cta">

            + Upload Video

        </a>

    </div>


    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="ef-error">
            @_error
        </div>
    }


    @if (_dashboard is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="stat-grid">

            <div class="stat">
                <div class="v">
                    @_dashboard.TotalVideos
                </div>

                <div class="l">
                    Videos
                </div>
            </div>


            <div class="stat">
                <div class="v">
                    @_dashboard.TotalViews
                </div>

                <div class="l">
                    Total views
                </div>
            </div>


            <div class="stat">
                <div class="v">
                    @_dashboard.AverageRating.ToString("0.0")
                </div>

                <div class="l">
                    Avg rating
                </div>
            </div>


            <div class="stat">
                <div class="v">
                    @_dashboard.TotalComments
                </div>

                <div class="l">
                    Comments
                </div>
            </div>

        </div>


        <h2 class="my-videos-title">
            My videos
        </h2>


        @if (_videos.Count == 0)
        {
            <div class="ef-empty">

                <p>
                    You haven't uploaded any videos yet.
                </p>

            </div>
        }
        else
        {
            <div class="video-list">

                @foreach (var video in _videos)
                {
                    <div class="video-row">

                        <a class="video-main"
                           href="/video/@video.Id">

                            <div class="thumb">

                                <video src="@Absolute(video.VideoUrl)"
                                       muted
                                       preload="metadata">
                                </video>

                            </div>


                            <div class="info">

                                <div class="title">
                                    @video.Title
                                </div>

                                <div class="meta">

                                    #@video.Genre
                                    ·
                                    @DisplayAgeRating(video.AgeRating)
                                    ·
                                    @video.ViewCount views
                                    ·
                                    @video.CreatedAt
                                        .ToLocalTime()
                                        .ToString("d MMM yyyy")

                                </div>

                            </div>

                        </a>


                        <div class="video-actions">

                            <button type="button"
                                    class="ef-ghost"
                                    @onclick="() => ViewVideo(video.Id)">

                                View

                            </button>


                            <button type="button"
                                    class="ef-ghost"
                                    @onclick="() => EditVideo(video.Id)">

                                Edit

                            </button>


                            <button type="button"
                                    class="delete-btn"
                                    @onclick="() => OpenDeleteDialog(video)">

                                Delete

                            </button>

                        </div>

                    </div>
                }

            </div>
        }
    }

</div>


@if (_videoPendingDelete is not null)
{
    <div class="modal-backdrop"
         @onclick="CloseDeleteDialog">

        <div class="delete-dialog"
             @onclick:stopPropagation="true">

            <div class="delete-icon">
                !
            </div>


            <h2>
                Delete video?
            </h2>


            <p>
                Are you sure you want to delete
                <strong>
                    "@_videoPendingDelete.Title"
                </strong>?
            </p>


            <p class="warning-text">
                This action cannot be undone.
                The video and its stored file will be permanently removed.
            </p>


            @if (!string.IsNullOrWhiteSpace(_deleteError))
            {
                <div class="ef-error">
                    @_deleteError
                </div>
            }


            <div class="dialog-actions">

                <button type="button"
                        class="ef-ghost"
                        disabled="@_deleting"
                        @onclick="CloseDeleteDialog">

                    Cancel

                </button>


                <button type="button"
                        class="confirm-delete"
                        disabled="@_deleting"
                        @onclick="ConfirmDelete">

                    @(_deleting
                        ? "Deleting…"
                        : "Delete video")

                </button>

            </div>

        </div>

    </div>
}


<style>

    .dashboard {
        padding: 2rem;

        max-width: 1050px;

        margin: 0 auto;

        height: 100%;

        overflow-y: auto;
    }


    .header {
        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 1rem;

        margin-bottom: 1.5rem;
    }


    .upload-cta {
        background: var(--ef-blue);

        color: white;

        padding: 0.6rem 1.1rem;

        border-radius: var(--ef-radius);

        text-decoration: none;

        font-weight: 600;

        white-space: nowrap;
    }


    .upload-cta:hover {
        background: var(--ef-blue-2);

        text-decoration: none;
    }


    .stat-grid {
        display: grid;

        grid-template-columns:
            repeat(auto-fit, minmax(160px, 1fr));

        gap: 1rem;
    }


    .stat {
        background: var(--ef-surface);

        border: 1px solid var(--ef-border);

        border-radius: var(--ef-radius);

        padding: 1.25rem;
    }


    .stat .v {
        font-size: 1.8rem;

        font-weight: 700;

        color: var(--ef-navy);
    }


    .stat .l {
        color: var(--ef-brown);

        font-size: 0.85rem;

        margin-top: 0.25rem;
    }


    .my-videos-title {
        margin-top: 2rem;
    }


    .video-list {
        display: flex;

        flex-direction: column;

        gap: 0.75rem;

        margin-top: 1rem;
    }


    .video-row {
        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 1rem;

        background: var(--ef-surface);

        border: 1px solid var(--ef-border);

        border-radius: var(--ef-radius);

        padding: 0.75rem;
    }


    .video-row:hover {
        box-shadow: var(--ef-shadow);
    }


    .video-main {
        display: flex;

        align-items: center;

        flex: 1;

        min-width: 0;

        gap: 1rem;

        text-decoration: none;

        color: inherit;
    }


    .video-main:hover {
        text-decoration: none;
    }


    .thumb {
        width: 70px;

        flex: 0 0 70px;

        aspect-ratio: 9 / 16;

        background: #000;

        border-radius: 8px;

        overflow: hidden;
    }


    .thumb video {
        width: 100%;

        height: 100%;

        object-fit: cover;
    }


    .info {
        min-width: 0;
    }


    .info .title {
        font-weight: 600;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;
    }


    .info .meta {
        color: var(--ef-brown);

        font-size: 0.85rem;

        margin-top: 0.25rem;
    }


    .video-actions {
        display: flex;

        gap: 0.5rem;

        flex-shrink: 0;
    }


    .video-actions button {
        padding: 0.45rem 0.75rem;
    }


    .delete-btn {
        background: #b91c1c;
    }


    .delete-btn:hover {
        background: #991b1b;
    }


    .modal-backdrop {
        position: fixed;

        inset: 0;

        background:
            rgba(15, 23, 42, 0.55);

        display: flex;

        align-items: center;

        justify-content: center;

        padding: 1rem;

        z-index: 100;
    }


    .delete-dialog {
        width: 100%;

        max-width: 430px;

        background: var(--ef-surface);

        border-radius: 16px;

        padding: 1.75rem;

        box-shadow:
            0 25px 70px
            rgba(15, 23, 42, 0.3);

        text-align: center;
    }


    .delete-icon {
        width: 52px;

        height: 52px;

        margin:
            0 auto 1rem;

        border-radius: 50%;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #fee2e2;

        color: #b91c1c;

        font-size: 1.6rem;

        font-weight: 800;
    }


    .delete-dialog h2 {
        margin-bottom: 0.5rem;
    }


    .delete-dialog p {
        margin:
            0.5rem 0;

        line-height: 1.5;
    }


    .warning-text {
        color: var(--ef-brown);

        font-size: 0.9rem;
    }


    .dialog-actions {
        display: flex;

        justify-content: flex-end;

        gap: 0.75rem;

        margin-top: 1.5rem;
    }


    .confirm-delete {
        background: #b91c1c;
    }


    .confirm-delete:hover:not(:disabled) {
        background: #991b1b;
    }


    @@media (max-width: 760px) {

        .dashboard {
            padding: 1rem;
        }

        .header {
            align-items: flex-start;

            flex-direction: column;
        }

        .video-row {
            align-items: stretch;

            flex-direction: column;
        }

        .video-actions {
            width: 100%;
        }

        .video-actions button {
            flex: 1;
        }

        .dialog-actions {
            flex-direction: column-reverse;
        }

        .dialog-actions button {
            width: 100%;
        }

    }

</style>


@code {

    private CreatorDashboardDto? _dashboard;

    private List<VideoSummary> _videos =
        new();

    private string _apiBase =
        string.Empty;

    private string? _error;

    private string? _deleteError;

    private VideoSummary? _videoPendingDelete;

    private bool _deleting;


    protected override async Task OnInitializedAsync()
    {
        _apiBase =
            Config["ApiBaseUrl"]
            ?? string.Empty;

        await LoadDashboardAsync();
    }


    private async Task LoadDashboardAsync()
    {
        try
        {
            _dashboard =
                await Api.GetCreatorDashboardAsync();

            var page =
                await Api.GetMyVideosAsync();

            _videos =
                page.Items;
        }
        catch
        {
            _error =
                "Creator dashboard could not be loaded.";
        }
    }


    private void ViewVideo(
        int id)
    {
        Nav.NavigateTo(
            $"/video/{id}");
    }


    private void EditVideo(
        int id)
    {
        Nav.NavigateTo(
            $"/creator/videos/{id}/edit");
    }


    private void OpenDeleteDialog(
        VideoSummary video)
    {
        _deleteError =
            null;

        _videoPendingDelete =
            video;
    }


    private void CloseDeleteDialog()
    {
        if (_deleting)
            return;

        _videoPendingDelete =
            null;

        _deleteError =
            null;
    }


    private async Task ConfirmDelete()
    {
        if (_videoPendingDelete is null)
            return;


        _deleting =
            true;

        _deleteError =
            null;


        var video =
            _videoPendingDelete;


        try
        {
            var (success, error) =
                await Api.DeleteVideoAsync(
                    video.Id);


            if (!success)
            {
                _deleteError =
                    error ??
                    "Video could not be deleted.";

                return;
            }


            _videos.Remove(
                video);


            _dashboard =
                await Api.GetCreatorDashboardAsync();


            _videoPendingDelete =
                null;
        }
        catch
        {
            _deleteError =
                "Video could not be deleted.";
        }
        finally
        {
            _deleting =
                false;
        }
    }


    private string Absolute(
        string url)
    {
        return url.StartsWith(
            "http",
            StringComparison.OrdinalIgnoreCase)

            ? url

            : $"{_apiBase.TrimEnd('/')}{url}";
    }


    private static string DisplayAgeRating(
        AgeRating rating)
    {
        return rating switch
        {
            AgeRating.U =>
                "U",

            AgeRating.PG =>
                "PG",

            AgeRating.Twelve =>
                "12",

            AgeRating.Fifteen =>
                "15",

            AgeRating.Eighteen =>
                "18",

            _ =>
                rating.ToString()
        };
    }

}