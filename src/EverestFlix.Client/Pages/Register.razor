@page "/register"
@inject EverestFlixApiClient          Api
@inject JwtAuthenticationStateProvider AuthState
@inject NavigationManager             Nav

<PageTitle>Create account · EverestFlix</PageTitle>

<div class="auth-page">
    <div class="ef-card auth-card">
        <div class="monogram-hero">EF</div>
        <h1>Create Account</h1>
        <p class="subtitle">Join EverestFlix and start sharing</p>

        <label class="ef-label" style="margin-top: 1rem;">I want to join as a:</label>
        <div class="toggle-btns">
            <button type="button"
                    class="@(_selectedRole == "Consumer" ? "active" : "")"
                    @onclick='() => _selectedRole = "Consumer"'>Consumer</button>
            <button type="button"
                    class="@(_selectedRole == "Creator" ? "active" : "")"
                    @onclick='() => _selectedRole = "Creator"'>Creator</button>
        </div>

        @if (_selectedRole == "Creator")
        {
            <div class="ef-info">
                Creator accounts require approval. Sign up as a Consumer for now — a platform administrator
                can grant Creator access using a creator access code.
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="ef-error">@_error</div>
        }

        <form @onsubmit="Submit" @onsubmit:preventDefault>
            <label class="ef-label" style="margin-top: 1rem;">Full name</label>
            <input class="ef-input" @bind="_request.FullName" required />

            <label class="ef-label" style="margin-top: 1rem;">Email address</label>
            <input class="ef-input" type="email" @bind="_request.Email" required />

            <label class="ef-label" style="margin-top: 1rem;">Password</label>
            <input class="ef-input" type="password" @bind="_request.Password" required
                   minlength="8" placeholder="Min 8 chars, upper, lower, digit" />

            <button type="submit" style="width: 100%; margin-top: 1.5rem;" disabled="@_busy">
                @(_busy ? "Creating account…" : "Create Account")
            </button>
        </form>

        <p class="footer-link">Already have an account? <a href="login">Log in</a></p>
    </div>
</div>

<style>
    .auth-page { padding: 3rem 1rem; height: 100%; overflow-y: auto; display: flex; justify-content: center; align-items: flex-start; }
    .auth-card { width: 100%; max-width: 460px; text-align: left; }
    .monogram-hero {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        background: var(--ef-blue);
        color: white;
        border-radius: 12px;
        font-weight: 800;
        margin-bottom: 1.5rem;
    }
    .subtitle { color: var(--ef-brown); margin: 0 0 1rem; }
    .toggle-btns { display: flex; gap: 0.5rem; margin-top: 0.35rem; }
    .toggle-btns button {
        flex: 1;
        background: var(--ef-surface);
        color: var(--ef-navy);
        border: 1px solid var(--ef-border);
    }
    .toggle-btns button.active {
        background: var(--ef-blue);
        color: white;
        border-color: var(--ef-blue);
    }
    .toggle-btns button:hover:not(.active) { background: var(--ef-bg); }
    .footer-link { text-align: center; color: var(--ef-brown); margin-top: 1.5rem; }
</style>

@code {
    private RegisterRequest _request      = new();
    private string          _selectedRole = "Consumer";
    private bool            _busy;
    private string?         _error;

    private async Task Submit()
    {
        _busy  = true;
        _error = null;

        var (response, error) = await Api.RegisterAsync(_request);
        if (response is null)
        {
            _error = error;
            _busy  = false;
            return;
        }

        await AuthState.LogInAsync(response.Token);
        Nav.NavigateTo("/");
    }
}