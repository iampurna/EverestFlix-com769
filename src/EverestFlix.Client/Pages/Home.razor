@page "/"
@implements IAsyncDisposable
@inject EverestFlixApiClient Api
@inject IJSRuntime           JS
@inject IConfiguration       Config

<PageTitle>EverestFlix</PageTitle>

@if (_loading)
{
    <div class="ef-empty"><h2>Loading videos…</h2></div>
}
else if (!_videos.Any())
{
    <div class="ef-empty">
        <h2>No videos yet</h2>
        <p>Log in as a Creator and upload the first one.</p>
    </div>
}
else
{
    <div class="reels-container" id="reels-container">
        @foreach (var v in _videos)
        {
            <div class="reel-slot">
                <Reel Video="v" ApiBase="@_apiBase" />
            </div>
        }
    </div>
}

<style>
    .reels-container {
        height: 100%;
        width: 100%;
        overflow-y: scroll;
        scroll-snap-type: y mandatory;
        scrollbar-width: none;
    }
    .reels-container::-webkit-scrollbar { display: none; }
    .reel-slot {
        height: 100%;
        width: 100%;
        scroll-snap-align: start;
    }
</style>

@code {
    private List<VideoSummary>          _videos  = new();
    private bool                        _loading = true;
    private DotNetObjectReference<Home>? _selfRef;
    private string                      _apiBase = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _apiBase = Config["ApiBaseUrl"] ?? string.Empty;
        var page = await Api.GetLatestAsync(1, 10);
        _videos  = page.Items;
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loading || !_videos.Any()) return;

        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("EverestFlixReels.initialise",
            _selfRef, "#reels-container", ".reel-slot");
    }

    [JSInvokable]
    public Task OnReelChanged(int videoId)
    {
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("EverestFlixReels.dispose"); }
        catch { }
        _selfRef?.Dispose();
    }
}