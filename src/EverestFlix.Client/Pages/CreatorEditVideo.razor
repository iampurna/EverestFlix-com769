@page "/creator/videos/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Creator")]

@inject EverestFlixApiClient Api
@inject NavigationManager Nav


<PageTitle>Edit Video · EverestFlix</PageTitle>


@if (_loading)
{
    <div class="ef-empty">
        <p>Loading video…</p>
    </div>
}
else if (_notFound)
{
    <div class="ef-empty">

        <h2>Video not found</h2>

        <p>
            The video does not exist.
        </p>

        <button type="button"
                @onclick="BackToDashboard">
            Back to dashboard
        </button>

    </div>
}
else if (_forbidden)
{
    <div class="ef-empty">

        <h2>Access denied</h2>

        <p>
            You can only edit your own videos.
        </p>

        <button type="button"
                @onclick="BackToDashboard">
            Back to dashboard
        </button>

    </div>
}
else
{
    <div class="edit-page">

        <div class="ef-card">

            <div class="page-header">

                <div>

                    <h1>Edit Video</h1>

                    <p class="subtitle">
                        Update the video's metadata
                    </p>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="ef-error">
                    @_error
                </div>
            }


            @if (_saved)
            {
                <div class="ef-success success-row">

                    <span>
                        ✓ Video updated successfully.
                    </span>

                </div>
            }


            <form @onsubmit="Save"
                  @onsubmit:preventDefault>


                <label class="ef-label">
                    Title
                </label>

                <input class="ef-input"
                       @bind="_title"
                       @bind:event="oninput"
                       maxlength="200"
                       required />


                <label class="ef-label field-space">
                    Description
                </label>

                <textarea class="ef-input"
                          @bind="_description"
                          @bind:event="oninput"
                          rows="4"
                          maxlength="2000">
                </textarea>


                <div class="row">

                    <div>

                        <label class="ef-label">
                            Publisher
                        </label>

                        <input class="ef-input"
                               @bind="_publisher"
                               @bind:event="oninput"
                               maxlength="150"
                               required />

                    </div>


                    <div>

                        <label class="ef-label">
                            Producer
                        </label>

                        <input class="ef-input"
                               @bind="_producer"
                               @bind:event="oninput"
                               maxlength="150"
                               required />

                    </div>

                </div>


                <div class="row">

                    <div>

                        <label class="ef-label">
                            Genre
                        </label>

                        <input class="ef-input"
                               @bind="_genre"
                               @bind:event="oninput"
                               maxlength="80"
                               required />

                    </div>


                    <div>

                        <label class="ef-label">
                            Age rating
                        </label>

                        <select class="ef-input"
                                @bind="_ageRating">

                            <option value="@AgeRating.U">
                                U (Universal)
                            </option>

                            <option value="@AgeRating.PG">
                                PG
                            </option>

                            <option value="@AgeRating.Twelve">
                                12
                            </option>

                            <option value="@AgeRating.Fifteen">
                                15
                            </option>

                            <option value="@AgeRating.Eighteen">
                                18
                            </option>

                        </select>

                    </div>

                </div>


                <div class="actions">

                    <button type="button"
                            class="ef-ghost"
                            @onclick="BackToDashboard">

                        ← Back to dashboard

                    </button>


                    @if (_saved)
                    {
                        <button type="button"
                                class="ef-ghost"
                                @onclick="ViewVideo">

                            View video

                        </button>
                    }


                    <button type="submit"
                            disabled="@(!CanSave)">

                        @(_saving
                            ? "Saving…"
                            : "Save changes")

                    </button>

                </div>

            </form>

        </div>

    </div>
}


<style>

    .edit-page {
        padding: 3rem 1rem;

        height: 100%;

        overflow-y: auto;

        display: flex;

        justify-content: center;

        align-items: flex-start;
    }


    .edit-page .ef-card {
        width: 100%;

        max-width: 680px;

        text-align: left;
    }


    .page-header {
        display: flex;

        justify-content: space-between;

        align-items: flex-start;

        margin-bottom: 1.5rem;
    }


    .subtitle {
        color: var(--ef-brown);

        margin: 0;
    }


    .success-row {
        display: flex;

        align-items: center;

        justify-content: space-between;
    }


    .field-space {
        margin-top: 1rem;
    }


    .row {
        display: grid;

        grid-template-columns:
            1fr 1fr;

        gap: 1rem;

        margin-top: 1rem;
    }


    .actions {
        display: flex;

        justify-content: flex-end;

        gap: 0.75rem;

        margin-top: 1.5rem;

        flex-wrap: wrap;
    }


    @@media (max-width: 640px) {

        .row {
            grid-template-columns:
                1fr;
        }

        .actions {
            flex-direction: column;
        }

        .actions button {
            width: 100%;
        }

    }

</style>


@code {

    [Parameter]
    public int Id { get; set; }


    private bool _loading =
        true;

    private bool _saving;

    private bool _saved;

    private bool _notFound;

    private bool _forbidden;


    private string? _error;


    private string _title =
        string.Empty;

    private string? _description;

    private string _publisher =
        string.Empty;

    private string _producer =
        string.Empty;

    private string _genre =
        string.Empty;

    private AgeRating _ageRating =
        AgeRating.U;


    private bool CanSave =>
        !_saving &&
        !string.IsNullOrWhiteSpace(_title) &&
        !string.IsNullOrWhiteSpace(_publisher) &&
        !string.IsNullOrWhiteSpace(_producer) &&
        !string.IsNullOrWhiteSpace(_genre);


    protected override async Task OnParametersSetAsync()
    {
        _loading =
            true;

        _error =
            null;

        _saved =
            false;

        _notFound =
            false;

        _forbidden =
            false;


        try
        {
            var user =
                await Api.GetMeAsync();


            var video =
                await Api.GetVideoAsync(
                    Id);


            if (video is null)
            {
                _notFound =
                    true;

                return;
            }


            if (user is null ||
                video.CreatorId != user.Id)
            {
                _forbidden =
                    true;

                return;
            }


            _title =
                video.Title;

            _description =
                video.Description;

            _publisher =
                video.Publisher;

            _producer =
                video.Producer;

            _genre =
                video.Genre;

            _ageRating =
                video.AgeRating;
        }
        catch
        {
            _error =
                "The video could not be loaded.";
        }
        finally
        {
            _loading =
                false;
        }
    }


    private async Task Save()
    {
        _saved =
            false;

        _error =
            Validate();


        if (_error is not null)
            return;


        _saving =
            true;


        try
        {
            var request =
                new UpdateVideoRequest
                {
                    Title =
                        _title.Trim(),

                    Description =
                        string.IsNullOrWhiteSpace(_description)
                            ? null
                            : _description.Trim(),

                    Publisher =
                        _publisher.Trim(),

                    Producer =
                        _producer.Trim(),

                    Genre =
                        _genre.Trim(),

                    AgeRating =
                        _ageRating
                };


            var (updated, error) =
                await Api.UpdateVideoAsync(
                    Id,
                    request);


            if (updated is null)
            {
                _error =
                    error ??
                    "Video could not be updated.";

                return;
            }


            _saved =
                true;


            _title =
                updated.Title;

            _description =
                updated.Description;

            _publisher =
                updated.Publisher;

            _producer =
                updated.Producer;

            _genre =
                updated.Genre;

            _ageRating =
                updated.AgeRating;
        }
        catch
        {
            _error =
                "Video could not be updated.";
        }
        finally
        {
            _saving =
                false;
        }
    }


    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(_title))
            return "Title is required.";

        if (string.IsNullOrWhiteSpace(_publisher))
            return "Publisher is required.";

        if (string.IsNullOrWhiteSpace(_producer))
            return "Producer is required.";

        if (string.IsNullOrWhiteSpace(_genre))
            return "Genre is required.";

        if (_title.Trim().Length > 200)
            return "Title must not exceed 200 characters.";

        if ((_description?.Trim().Length ?? 0) > 2000)
            return "Description must not exceed 2000 characters.";

        if (_publisher.Trim().Length > 150)
            return "Publisher must not exceed 150 characters.";

        if (_producer.Trim().Length > 150)
            return "Producer must not exceed 150 characters.";

        if (_genre.Trim().Length > 80)
            return "Genre must not exceed 80 characters.";

        return null;
    }


    private void BackToDashboard()
    {
        Nav.NavigateTo(
            "/creator/dashboard");
    }


    private void ViewVideo()
    {
        Nav.NavigateTo(
            $"/video/{Id}");
    }

}