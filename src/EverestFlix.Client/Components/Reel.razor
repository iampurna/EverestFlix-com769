@inject IJSRuntime JS
@inject EverestFlixApiClient Api
@inject NavigationManager Nav


<div class="reel"
     data-video-id="@Video.Id">

    <div class="reel-stage">

        <div class="phone-frame">

            <video class="reel-video"
                   controls
                   muted
                   loop
                   playsinline
                   preload="metadata"
                   @onerror="OnVideoError">

                <source src="@AbsoluteVideoUrl"
                        type="video/mp4" />

            </video>


            @if (_hasError)
            {
                <div class="reel-fallback">

                    <div class="fallback-inner">

                        <div class="fallback-badge">
                            Preview unavailable
                        </div>

                        <p>
                            <code>
                                @Video.VideoUrl
                            </code>
                        </p>

                        <p class="hint">
                            This video could not be played.
                        </p>

                    </div>

                </div>
            }


            <div class="reel-meta">

                <div class="creator">
                    @Video.CreatorName
                </div>

                <div class="title">
                    @Video.Title
                </div>

                <div class="tags">

                    <span class="tag">
                        #@Video.Genre
                    </span>

                    <span class="tag">
                        @DisplayAgeRating(Video.AgeRating)
                    </span>

                    <span class="tag">
                        @Video.ViewCount views
                    </span>

                </div>

            </div>

        </div>


        <div class="side-rail">

            <ActionRail
                CommentCount="@_commentCount"
                RatingAverage="@_ratingAverage"
                OnCommentsClick="OpenComments"
                OnRateClick="OpenRating"
                OnShareClick="Share" />

            @if (_shareCopied)
            {
                <div class="share-message">
                    Copied!
                </div>
            }

        </div>

    </div>

</div>


<style>

    .reel {
        width: 100%;
        height: 100%;

        background:
            var(--ef-bg);

        display: flex;

        align-items: center;
        justify-content: center;

        padding: 1rem 0;
    }


    .reel-stage {
        position: relative;

        display: flex;

        align-items: center;

        gap: 1rem;

        height: 100%;

        max-height: 720px;
    }


    .phone-frame {
        position: relative;

        aspect-ratio: 9 / 16;

        height: 100%;

        max-height: 720px;

        background: #000;

        border-radius: 20px;

        overflow: hidden;

        box-shadow:
            0 20px 60px
            rgba(15, 23, 42, 0.15);

        border:
            1px solid var(--ef-border);
    }


    .reel-video {
        width: 100%;
        height: 100%;

        object-fit: cover;
    }


    .reel-fallback {
        position: absolute;

        inset: 0;

        display: flex;

        align-items: center;
        justify-content: center;

        background:
            linear-gradient(
                180deg,
                #1e3a8a 0%,
                #2848a7 100%
            );

        color: white;
    }


    .fallback-inner {
        text-align: center;

        padding: 1.5rem;

        max-width: 300px;
    }


    .fallback-badge {
        display: inline-block;

        background:
            rgba(255, 255, 255, 0.2);

        color: white;

        padding:
            0.3rem 0.75rem;

        border-radius:
            999px;

        font-size:
            0.75rem;

        margin-bottom:
            1rem;
    }


    .reel-meta {
        position: absolute;

        bottom: 3.5rem;

        left: 1rem;
        right: 1rem;

        color: white;

        z-index: 4;

        pointer-events: none;

        text-shadow:
            0 1px 6px
            rgba(0, 0, 0, 0.8);
    }


    .creator {
        font-weight: 700;

        margin-bottom:
            0.3rem;

        font-size:
            0.9rem;
    }


    .title {
        font-size: 1rem;

        font-weight: 600;

        margin-bottom:
            0.4rem;
    }


    .tags {
        display: flex;

        gap: 0.35rem;

        flex-wrap: wrap;
    }


    .tag {
        background:
            rgba(0, 0, 0, 0.5);

        padding:
            0.15rem 0.5rem;

        border-radius:
            999px;

        font-size:
            0.7rem;
    }


    .side-rail {
        position: relative;

        width: 48px;

        height: 100%;

        max-height: 720px;
    }


    .share-message {
        position: absolute;

        bottom: 0;

        right: 55px;

        background:
            var(--ef-navy);

        color: white;

        padding:
            0.35rem 0.65rem;

        border-radius:
            8px;

        font-size:
            0.75rem;

        white-space: nowrap;
    }


    @@media (max-width: 640px) {

        .reel {
            padding: 0;
        }

        .phone-frame {
            border-radius: 0;

            border: none;

            height: 100%;

            max-height: none;

            width: 100%;

            box-shadow: none;
        }

        .reel-stage {
            height: 100%;

            max-height: none;

            width: 100%;
        }

        .side-rail {
            position: absolute;

            right: 0;

            top: 0;
        }

        .reel-meta {
            bottom: 4rem;
        }

    }

</style>


@code {

    [Parameter, EditorRequired]
    public VideoSummary Video { get; set; } =
        default!;


    [Parameter]
    public string ApiBase { get; set; } =
        string.Empty;


    [Parameter]
    public EventCallback<int>
        OnOpenComments { get; set; }


    [Parameter]
    public EventCallback<int>
        OnOpenRating { get; set; }


    private bool _hasError;

    private bool _shareCopied;

    private int _commentCount;

    private double _ratingAverage;


    private string AbsoluteVideoUrl =>
        Video.VideoUrl.StartsWith(
            "http",
            StringComparison.OrdinalIgnoreCase)

            ? Video.VideoUrl

            : $"{ApiBase.TrimEnd('/')}{Video.VideoUrl}";


    protected override async Task
        OnParametersSetAsync()
    {
        await LoadInteractionSummaryAsync();
    }


    private async Task
        LoadInteractionSummaryAsync()
    {
        try
        {
            var comments =
                await Api.GetCommentsAsync(
                    Video.Id,
                    page: 1,
                    pageSize: 1);

            _commentCount =
                (int)Math.Min(
                    comments.TotalItems,
                    int.MaxValue);


            var rating =
                await Api.GetRatingAsync(
                    Video.Id);

            _ratingAverage =
                rating.Average;
        }
        catch
        {
            _commentCount =
                0;

            _ratingAverage =
                0;
        }
    }


    private void OnVideoError()
    {
        _hasError =
            true;
    }


    private Task OpenComments()
    {
        return OnOpenComments.InvokeAsync(
            Video.Id);
    }


    private Task OpenRating()
    {
        return OnOpenRating.InvokeAsync(
            Video.Id);
    }


    private async Task Share()
    {
        var shareUrl =
            $"{Nav.BaseUri.TrimEnd('/')}/video/{Video.Id}";

        await JS.InvokeVoidAsync(
            "navigator.clipboard.writeText",
            shareUrl);

        _shareCopied =
            true;

        await InvokeAsync(
            StateHasChanged);

        await Task.Delay(
            1500);

        _shareCopied =
            false;

        await InvokeAsync(
            StateHasChanged);
    }


    private static string DisplayAgeRating(
        AgeRating rating)
    {
        return rating switch
        {
            AgeRating.U =>
                "U",

            AgeRating.PG =>
                "PG",

            AgeRating.Twelve =>
                "12",

            AgeRating.Fifteen =>
                "15",

            AgeRating.Eighteen =>
                "18",

            _ =>
                rating.ToString()
        };
    }

}